# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Группа по умолчанию для новых пользователей
DEFAULT_GROUP=ИС-21

# Путь к файлу базы данных (необязательно, по умолчанию: smart_duty.db)
# Для Render: DB_PATH=/opt/render/project/data/smart_duty.db
DB_PATH=smart_duty.db

# Хост и порт для API (необязательно, по умолчанию: 127.0.0.1:8000)
# Render автоматически устанавливает PORT
HOST=127.0.0.1
PORT=8000
